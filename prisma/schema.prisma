// Bethesda Home & School for the Blind — Staff Management System
// Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Core identity & org structure
// ---------------------------------------------------------------------------

model Staff {
  id                 String    @id @default(cuid())
  staffCode          String    @unique // e.g. BHB-0042, mapped to ZKTeco device user ID
  fullName           String
  email              String?   @unique
  phone              String?
  role               StaffRole
  category           StaffCategory // Teaching / Non-teaching (academic vs non-academic)
  department         Department @relation(fields: [departmentId], references: [id])
  departmentId       String
  employmentType     EmploymentType
  isVisuallyImpaired Boolean   @default(false) // informs UI/communication preferences, not access control
  dateHired          DateTime
  dateExited         DateTime?
  active             Boolean   @default(true)

  // --- Personal / HR detail ---
  dateOfBirth           DateTime?
  gender                Gender?
  maritalStatus         MaritalStatus?
  nationality           String?
  stateOfOrigin         String?
  homeAddress           String?
  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinRelationship String?
  bankName              String?
  bankAccountNumber     String?
  bankAccountName       String?
  passportPhotoUrl      String?

  shiftAssignments ShiftAssignment[]
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  documents        StaffDocument[]
  qualifications   Qualification[]
  user             User?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([active])
  @@index([category])
}

enum StaffRole {
  SUPER_ADMIN
  HR_ADMIN
  SUPERVISOR
  TEACHER
  HOUSE_PARENT
  SUPPORT_STAFF
}

enum StaffCategory {
  TEACHING     // Academic staff — classroom/instructional roles
  NON_TEACHING // Non-academic staff — admin, kitchen, security, grounds, etc.
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  VOLUNTEER
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

model Department {
  id    String  @id @default(cuid())
  name  String  @unique // Academics, Boarding/House, Admin, Kitchen, Security, Grounds
  staff Staff[]
}

// ---------------------------------------------------------------------------
// Shifts & attendance
// ---------------------------------------------------------------------------

model ShiftType {
  id                 String   @id @default(cuid())
  name               String // "School Day", "Boarding Night", "Boarding Day"
  startTime          String // "07:30"
  endTime            String // "15:30"
  gracePeriodMinutes Int      @default(10)
  assignments        ShiftAssignment[]
}

model ShiftAssignment {
  id            String    @id @default(cuid())
  staff         Staff     @relation(fields: [staffId], references: [id])
  staffId       String
  shiftType     ShiftType @relation(fields: [shiftTypeId], references: [id])
  shiftTypeId   String
  daysOfWeek    Int[] // 0=Sun ... 6=Sat
  effectiveFrom DateTime
  effectiveTo   DateTime?

  @@index([staffId])
}

model Device {
  id          String   @id @default(cuid())
  name        String // "Main Entrance K40"
  localIp     String
  location    String
  lastSyncAt  DateTime?
  attendances Attendance[]
}

model Attendance {
  id        String           @id @default(cuid())
  staff     Staff            @relation(fields: [staffId], references: [id])
  staffId   String
  device    Device           @relation(fields: [deviceId], references: [id])
  deviceId  String
  timestamp DateTime
  type      AttendanceType
  status    AttendanceStatus
  source    AttendanceSource
  createdAt DateTime         @default(now())

  @@index([staffId, timestamp])
  @@index([deviceId])
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceStatus {
  ON_TIME
  LATE
  EARLY_DEPARTURE
  MANUAL_OVERRIDE
}

enum AttendanceSource {
  BIOMETRIC
  MANUAL
}

// ---------------------------------------------------------------------------
// Leave
// ---------------------------------------------------------------------------

model LeaveType {
  id                 String         @id @default(cuid())
  name               String // Annual, Sick, Casual, Maternity/Paternity, Unpaid
  defaultDaysPerYear Int
  requests           LeaveRequest[]
}

model LeaveRequest {
  id          String      @id @default(cuid())
  staff       Staff       @relation(fields: [staffId], references: [id])
  staffId     String
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
  leaveTypeId String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  decidedAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([staffId])
  @@index([status])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Qualifications, results & documents
// ---------------------------------------------------------------------------

// A staff member's academic/professional qualifications — WAEC/SSCE results,
// NCE, degrees, professional certifications, etc. Each can optionally point
// to the scanned certificate/result slip stored as a StaffDocument.
model Qualification {
  id                 String            @id @default(cuid())
  staff              Staff             @relation(fields: [staffId], references: [id])
  staffId            String
  level              QualificationLevel
  awardingBody       String // "WAEC", "University of Lagos", "TRCN", etc.
  fieldOfStudy       String? // "Special Education", "Guidance & Counselling"
  grade              String? // "Distinction", "Second Class Upper", "Credit"
  yearObtained       Int?
  certificateDoc     StaffDocument?    @relation(fields: [certificateDocId], references: [id])
  certificateDocId   String?           @unique
  createdAt          DateTime          @default(now())

  @@index([staffId])
}

enum QualificationLevel {
  SSCE_WAEC
  OND
  NCE
  HND
  BSC
  PGD
  MSC
  PHD
  PROFESSIONAL_CERT // e.g. TRCN, ICAN, first aid, sign language cert
  OTHER
}

model StaffDocument {
  id           String       @id @default(cuid())
  staff        Staff        @relation(fields: [staffId], references: [id])
  staffId      String
  type         DocumentType
  label        String // free-text description, e.g. "2021 NCE Certificate"
  fileUrl      String
  expiresAt    DateTime?
  uploadedAt   DateTime     @default(now())

  qualification Qualification?

  @@index([staffId])
  @@index([type])
}

enum DocumentType {
  ID_CARD
  CONTRACT
  QUALIFICATION_CERTIFICATE // degree/NCE/professional certs
  EXAM_RESULT               // WAEC/SSCE result slips etc.
  MEDICAL_REPORT
  OTHER
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String // admin/user who made the change
  action     String // "MANUAL_ATTENDANCE_OVERRIDE", "STAFF_EDITED", etc.
  targetType String // "Attendance", "Staff", "LeaveRequest"
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Auth (Better Auth schema — Lucia is deprecated as of 2025; Better Auth is
// the actively maintained successor recommended for new TypeScript projects)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  role          StaffRole @default(SUPPORT_STAFF)

  staff   Staff?  @relation(fields: [staffId], references: [id])
  staffId String? @unique

  sessions Session[]
  accounts Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  issuer                String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
