generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Staff {
  id                    String            @id @default(cuid())
  staffCode             String            @unique
  fullName              String
  email                 String?           @unique
  phone                 String?
  role                  StaffRole
  category              StaffCategory?
  departmentId          String
  employmentType        EmploymentType
  isVisuallyImpaired    Boolean           @default(false)
  dateHired             DateTime
  dateExited            DateTime?
  active                Boolean           @default(true)
  dateOfBirth           DateTime?
  gender                Gender?
  maritalStatus         MaritalStatus?
  nationality           String?
  stateOfOrigin         String?
  homeAddress           String?
  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinRelationship String?
  bankName              String?
  bankAccountNumber     String?
  bankAccountName       String?
  passportPhotoUrl      String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  currentSalary         Decimal?          @db.Decimal(12, 2)
  attendances           Attendance[]
  leaveRequests         LeaveRequest[]
  payslips              Payslip[]
  qualifications        Qualification[]
  shiftAssignments      ShiftAssignment[]
  department            Department        @relation(fields: [departmentId], references: [id])
  deductionsIssued      StaffDeduction[]  @relation("DeductionsIssued")
  deductionsReceived    StaffDeduction[]  @relation("DeductionsReceived")
  documents             StaffDocument[]
  queriesIssued         StaffQuery[]      @relation("QueriesIssued")
  queriesReceived       StaffQuery[]      @relation("QueriesReceived")
  user                  User?

  @@index([departmentId])
  @@index([active])
  @@index([category])
}

model Department {
  id    String  @id @default(cuid())
  name  String  @unique
  staff Staff[]
}

model ShiftType {
  id                 String            @id @default(cuid())
  name               String
  startTime          String
  endTime            String
  gracePeriodMinutes Int               @default(10)
  assignments        ShiftAssignment[]
}

model ShiftAssignment {
  id            String    @id @default(cuid())
  staffId       String
  shiftTypeId   String
  daysOfWeek    Int[]
  effectiveFrom DateTime
  effectiveTo   DateTime?
  shiftType     ShiftType @relation(fields: [shiftTypeId], references: [id])
  staff         Staff     @relation(fields: [staffId], references: [id])

  @@index([staffId])
}

model Device {
  id          String       @id @default(cuid())
  name        String
  localIp     String
  location    String
  lastSyncAt  DateTime?
  attendances Attendance[]
}

model Attendance {
  id        String           @id @default(cuid())
  staffId   String
  deviceId  String
  timestamp DateTime
  type      AttendanceType
  status    AttendanceStatus
  source    AttendanceSource
  createdAt DateTime         @default(now())
  device    Device           @relation(fields: [deviceId], references: [id])
  staff     Staff            @relation(fields: [staffId], references: [id])

  @@unique([staffId, deviceId, timestamp, type])
  @@index([staffId, timestamp])
  @@index([deviceId])
}

model LeaveType {
  id                 String         @id @default(cuid())
  name               String
  defaultDaysPerYear Int
  requests           LeaveRequest[]
}

model LeaveRequest {
  id          String      @id @default(cuid())
  staffId     String
  leaveTypeId String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  decidedAt   DateTime?
  createdAt   DateTime    @default(now())
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
  staff       Staff       @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([status])
}

model Qualification {
  id               String             @id @default(cuid())
  staffId          String
  level            QualificationLevel
  awardingBody     String
  fieldOfStudy     String?
  grade            String?
  yearObtained     Int?
  certificateDocId String?            @unique
  createdAt        DateTime           @default(now())
  certificateDoc   StaffDocument?     @relation(fields: [certificateDocId], references: [id])
  staff            Staff              @relation(fields: [staffId], references: [id])

  @@index([staffId])
}

model StaffDocument {
  id            String         @id @default(cuid())
  staffId       String
  type          DocumentType?
  label         String
  fileUrl       String
  expiresAt     DateTime?
  uploadedAt    DateTime       @default(now())
  qualification Qualification?
  staff         Staff          @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([type])
}

model Visitor {
  id             String          @id @default(cuid())
  fullName       String
  phone          String?
  organization   String?
  category       VisitorCategory @default(GENERAL)
  purposeOfVisit String
  personToSee    String
  badgeNumber    String?
  timeIn         DateTime        @default(now())
  timeOut        DateTime?
  registeredBy   String
  notes          String?
  createdAt      DateTime        @default(now())
  voided         Boolean         @default(false)
  voidedAt       DateTime?
  voidedBy       String?
  voidReason     String?
  donations      Donation[]

  @@index([timeIn])
  @@index([category])
  @@index([voided])
}

model Donation {
  id                String       @id @default(cuid())
  donorName         String
  donorType         DonorType    @default(INDIVIDUAL)
  donorContact      String?
  donationType      DonationType
  amount            Decimal?     @db.Decimal(12, 2)
  currency          String       @default("NGN")
  inKindDescription String?
  purpose           String?
  receiptNumber     String?
  donatedAt         DateTime     @default(now())
  recordedBy        String
  notes             String?
  createdAt         DateTime     @default(now())
  visitorId         String?
  voided            Boolean      @default(false)
  voidedAt          DateTime?
  voidedBy          String?
  voidReason        String?
  visitor           Visitor?     @relation(fields: [visitorId], references: [id])

  @@index([donatedAt])
  @@index([donorType])
  @@index([voided])
  @@index([visitorId])
}

model StaffQuery {
  id               String        @id @default(cuid())
  staffId          String
  issuedById       String
  category         QueryCategory
  subject          String
  description      String
  dateIssued       DateTime      @default(now())
  responseDeadline DateTime?
  staffResponse    String?
  respondedAt      DateTime?
  status           QueryStatus   @default(PENDING_RESPONSE)
  deductionAmount  Decimal?      @db.Decimal(12, 2)
  payslipId        String?
  createdAt        DateTime      @default(now())
  issuedBy         Staff         @relation("QueriesIssued", fields: [issuedById], references: [id])
  payslip          Payslip?      @relation(fields: [payslipId], references: [id])
  staff            Staff         @relation("QueriesReceived", fields: [staffId], references: [id])

  @@index([staffId])
  @@index([status])
}

model StaffDeduction {
  id         String   @id @default(cuid())
  staffId    String
  issuedById String
  reason     String
  amount     Decimal  @db.Decimal(12, 2)
  dateIssued DateTime @default(now())
  payslipId  String?
  createdAt  DateTime @default(now())
  issuedBy   Staff    @relation("DeductionsIssued", fields: [issuedById], references: [id])
  payslip    Payslip? @relation(fields: [payslipId], references: [id])
  staff      Staff    @relation("DeductionsReceived", fields: [staffId], references: [id])

  @@index([staffId])
}

model PayrollPeriod {
  id          String        @id @default(cuid())
  month       Int
  year        Int
  status      PayrollStatus @default(DRAFT)
  generatedBy String
  finalizedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  payslips    Payslip[]

  @@unique([month, year])
}

model Payslip {
  id                 String           @id @default(cuid())
  periodId           String
  staffId            String
  baseSalary         Decimal          @db.Decimal(12, 2)
  lateCount          Int              @default(0)
  absenceCount       Int              @default(0)
  queryDeductions    Decimal          @default(0) @db.Decimal(12, 2)
  queryDeductionNote String?
  otherDeductions    Decimal          @default(0) @db.Decimal(12, 2)
  otherDeductionNote String?
  netPay             Decimal          @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  period             PayrollPeriod    @relation(fields: [periodId], references: [id])
  staff              Staff            @relation(fields: [staffId], references: [id])
  deductions         StaffDeduction[]
  queries            StaffQuery[]

  @@unique([periodId, staffId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  role          StaffRole @default(SUPPORT_STAFF)
  staffId       String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  staff         Staff?    @relation(fields: [staffId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  issuer                String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum StaffRole {
  SUPER_ADMIN
  HR_ADMIN
  SUPERVISOR
  TEACHER
  HOUSE_PARENT
  SUPPORT_STAFF
}

enum StaffCategory {
  TEACHING
  NON_TEACHING
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  VOLUNTEER
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceStatus {
  ON_TIME
  LATE
  EARLY_DEPARTURE
  MANUAL_OVERRIDE
}

enum AttendanceSource {
  BIOMETRIC
  MANUAL
  WEB_SELF
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QualificationLevel {
  SSCE_WAEC
  OND
  NCE
  HND
  BSC
  PGD
  MSC
  PHD
  PROFESSIONAL_CERT
  OTHER
}

enum DocumentType {
  ID_CARD
  CONTRACT
  QUALIFICATION_CERTIFICATE
  EXAM_RESULT
  MEDICAL_REPORT
  OTHER
}

enum VisitorCategory {
  GENERAL
  PARENT_GUARDIAN
  VENDOR_SUPPLIER
  GOVERNMENT_OFFICIAL
  DONOR_PARTNER
  VOLUNTEER_PROSPECT
  OTHER
}

enum DonorType {
  INDIVIDUAL
  ORGANIZATION
  CHURCH_FAITH_BASED
  GOVERNMENT
  OTHER
}

enum DonationType {
  CASH
  BANK_TRANSFER
  CHEQUE
  IN_KIND
}

enum QueryCategory {
  LATENESS
  ABSENTEEISM
  MISCONDUCT
  POLICY_VIOLATION
  PERFORMANCE
  OTHER
}

enum QueryStatus {
  PENDING_RESPONSE
  RESPONDED
  RESOLVED
  ESCALATED
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}
